In[10187]:=",ExpressionUUID->"e208f8fb-fa6e-4ff4-8022-eacffcafded5"],

Cell[BoxData["\<\"\\n\\n\\n\\!\\(\\*StyleBox[\\\"Boost\\\",FontWeight->\\\"\
Bold\\\"]\\)\\!\\(\\*StyleBox[\\\" \
