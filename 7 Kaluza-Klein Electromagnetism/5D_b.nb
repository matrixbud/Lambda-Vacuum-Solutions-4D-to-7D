   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< and off-diagonal metric components \n\t \
\!\(\*SubscriptBox[\(g\), \(04\)]\) = \!\(\*SubscriptBox[\(g\), \(40\)]\) = \
\>\"", ",", 
