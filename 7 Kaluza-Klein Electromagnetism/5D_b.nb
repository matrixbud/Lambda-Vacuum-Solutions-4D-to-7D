   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Using this starting point, the non-zero Lambda field \
equations are\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"\[Mu]", "=", "dimL"}], ",", 
      RowBox[{"\[Mu]", "\[LessEqual]", "dimH"}], ",", 
      RowBox[{"\[Mu]", "++"}], ",", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"\[Nu]", "=", "\[Mu]"}], ",", 
        RowBox[{"\[Nu]", "\[LessEqual]", "dimH"}], ",", 
        RowBox[{"\[Nu]", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"R", "[", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "===", "0"}], ")"}]}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<R\>\"", ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], "]"}]}], "]"}], 
            ",", "\"\<:  \>\"", ",", 
            RowBox[{
             RowBox[{"lhs", "[", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "/.", " ", 
             "rulesDisp"}], ",", "\"\< = \>\"", ",", 
            RowBox[{"rhs", "[", 
             RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}], "]"}]}], "]"}]}], 
       "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\!\(\*SubscriptBox[\(R\), \(33\)]\) is redundant, the \
same as \!\(\*SubscriptBox[\(R\), \(22\)]\).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Keeping only first-order terms [i.e., dropping terms \
of order \[Epsilon]],\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\!\(\*SubscriptBox[\(R\), \(00\)]\), \
\!\(\*SubscriptBox[\(R\), \(11\)]\), \!\(\*SubscriptBox[\(R\), \(22\)]\), and \
\!\(\*SubscriptBox[\(R\), \(44\)]\) become 0=0 identities, leaving only \
\!\(\*SubscriptBox[\(R\), \(04\)]\):\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"\[Mu]", "=", "dimL"}], ",", 
      RowBox[{"\[Mu]", "\[LessEqual]", "dimH"}], ",", 
      RowBox[{"\[Mu]", "++"}], ",", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"\[Nu]", "=", "\[Mu]"}], ",", 
        RowBox[{"\[Nu]", "\[LessEqual]", "dimH"}], ",", 
        RowBox[{"\[Nu]", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"!", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"R", "[", 
                RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "===", "0"}], ")"}]}],
             ")"}], "&&", 
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{"\[Mu]", "==", "3"}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<R\>\"", ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], "]"}]}], "]"}], 
            ",", "\"\<:  \>\"", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"lhs", "[", 
               RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "/.", 
              RowBox[{"\[Epsilon]", "->", "0"}]}], "/.", " ", "rulesDisp"}], 
            ",", "\"\< = \>\"", ",", 
            RowBox[{"rhs", "[", 
             RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}], "]"}]}], "]"}]}], 
       "]"}]}], "]"}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"setting", " ", "\[Epsilon]"}], "->", 
      RowBox[{"0", " ", "is", " ", "only", " ", "ok", " ", "in", " ", 
       SubscriptBox["R", "04"], " ", "because"}]}], ",", " ", 
     RowBox[{"unlike", " ", "the", " ", "other", " ", "equations"}], ",", " ", 
     RowBox[{
     "we", " ", "divided", " ", "both", " ", "sides", " ", "by", " ", 
      SubscriptBox["g", "04"]}], ",", " ", 
     RowBox[{"which", " ", "has", " ", "an", " ", "\[Epsilon]", " ", 
      RowBox[{"factor", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"num04", "=", 
     RowBox[{"Numerator", "[", 
      RowBox[{"Simplify", "[", 
       RowBox[{"lhs", "[", 
        RowBox[{"0", ",", "4"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\!\(\*SubscriptBox[\(R\), \(04\)]\) can be simplified \
by finding a common denominator and setting the numerator\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<to zero:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \!\(\*SubscriptBox[\(R\), \(04\)]\):  \>\"", ",", 
      RowBox[{
       RowBox[{"num04", "/.", 
        RowBox[{"\[Epsilon]", "->", "0"}]}], "/.", " ", "rulesDisp"}], 
      ",", "\"\< = 0\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Factoring out the polynomial \
(2m-r\!\(\*SuperscriptBox[\()\), \(2\)]\), this becomes\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lhs04", "=", 
     RowBox[{"Expand", "[", 
      FractionBox[
       RowBox[{"Simplify", "[", 
        RowBox[{"num04", "/.", 
         RowBox[{"\[Epsilon]", "->", "0"}]}], "]"}], 
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", "m"}], "+", "r"}], ")"}], "2"]}]], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \!\(\*SubscriptBox[\(R\), \(04\)]\):  \>\"", ",", 
      RowBox[{"lhs04", "/.", " ", "rulesDisp"}], ",", "\"\< = 0\>\""}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{"DSolveValue", "[", 
       RowBox[{
        RowBox[{"lhs04", "==", "0"}], ",", 
        RowBox[{"h", "[", "r", "]"}], ",", "r"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"C", "[", "1", "]"}], "->", 
         RowBox[{"-", 
          SubscriptBox["C", "2"]}]}], ",", 
        RowBox[{
         RowBox[{"C", "[", "2", "]"}], "->", 
         SubscriptBox["C", "1"]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< \[Implies]         h(r) = \>\"", ",", 
      RowBox[{"h", "[", "r", "]"}], 
      ",", "\"\<  where \!\(\*SubscriptBox[\(C\), \(1\)]\) and \
\!\(\*SubscriptBox[\(C\), \(2\)]\) are constants of integration.\>\""}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
