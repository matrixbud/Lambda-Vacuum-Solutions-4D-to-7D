Cell[BoxData[{
 RowBox[{
  RowBox[{"lineElem", ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "firstElem", ",", "fourterms", ",", "kount", ",", "kount4", ",", "line",
        ",", "g\[Mu]\[Nu]", ",", "gzero", ",", "x\[Mu]", ",", "x\[Nu]", ",", 
       "\n", "negSign", ",", "factor", ",", "plus", ",", "posTerm", ",", 
       "Lparen", ",", "Rparen", ",", "nextTerm", ",", "lineElem"}], "}"}], ",",
      "\n", "\n", 
     RowBox[{
      RowBox[{"fourterms", "=", "\"\<\>\""}], ";", "\n", 
      RowBox[{"firstElem", "=", "1"}], ";", "\n", 
      RowBox[{"kount", "=", "0"}], ";", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Counter", " ", "of", " ", "terms", " ", "being", " ", "printed"}], 
       " ", "*)"}], "\n", 
      RowBox[{"kount4", "=", "0"}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Counter", " ", "of", " ", "#", " ", "of", " ", "rows", " ", "to", " ",
         "output"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"\[Mu]", "=", "dimL"}], ",", 
        RowBox[{"\[Mu]", "\[LessEqual]", "dimH"}], ",", 
        RowBox[{"\[Mu]", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"\[Nu]", "=", "dimL"}], ",", 
          RowBox[{"\[Nu]", "\[LessEqual]", "dimH"}], ",", 
          RowBox[{"\[Nu]", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"g", "[", 
               RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "===", "0"}], ",", 
             RowBox[{"gzero", "=", "0"}], ",", 
             RowBox[{"gzero", "=", "1"}], ",", 
             RowBox[{"gzero", "=", "1"}]}], "]"}], ";", " ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"1", " ", "means", " ", 
              SubscriptBox["g", "\[Mu]\[Nu]"]}], "\[NotEqual]", "0"}], " ", 
            "*)"}], "\n", "\n", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"gzero", "==", "1"}], ",", "  ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{"If", " ", "there", " ", "is", " ", "a", " ", "non"}], 
               "-", 
               RowBox[{"zero", " ", 
                SubscriptBox["g", "\[Mu]\[Nu]"], " ", "term", " ", "to", " ", 
                "print"}]}], " ", "*)"}], "\n", 
             RowBox[{
              RowBox[{"kount", "=", 
               RowBox[{"kount", "+", "1"}]}], ";", "  ", 
              RowBox[{"(*", " ", 
               RowBox[{
               "Increment", " ", "#", " ", "of", " ", "terms", " ", "being", " ",
                 "printed", " ", 
                RowBox[{"(", 
                 RowBox[{"4", " ", "per", " ", "row"}], ")"}]}], " ", "*)"}], 
              "\n", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"Print", "[", 
                 
                 RowBox[{"\"\<\[Mu], \[Nu], kount: \>\"", ",", "\[Mu]", 
                  ",", "\"\<, \>\"", ",", "\[Nu]", ",", "\"\<, \>\"", ",", 
                  "kount"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
              "\n", 
              RowBox[{"g\[Mu]\[Nu]", "=", 
               RowBox[{"g", "[", 
                RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}], ";", "\n", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<g\[Mu]\[Nu] = \>\"", ",", "g\[Mu]\[Nu]"}], 
                  "]"}], "\n", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<\[ScriptX][\[Nu]], \[ScriptX]\[Nu] = \>\"", ",", 
                   RowBox[{"\[ScriptX]", "[", "\[Nu]", "]"}], 
                   ",", "\"\<, \>\"", ",", 
                   RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"\[ScriptX]", "[", "\[Nu]", "]"}], "//", 
                    "OutputForm"}], "]"}]}], "]"}]}], ";"}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"x\[Mu]", "=", 
               RowBox[{"ToString", "[", 
                RowBox[{"\[ScriptX]", "[", "\[Mu]", "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"x\[Nu]", "=", 
               RowBox[{"ToString", "[", 
                RowBox[{"\[ScriptX]", "[", "\[Nu]", "]"}], "]"}]}], ";", "\n",
               "\n", 
              RowBox[{"negSign", "=", 
               RowBox[{"Module", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"e", "=", 
                    RowBox[{"Expand", "[", "g\[Mu]\[Nu]", "]"}]}], ",", 
                   "lead"}], "}"}], ",", "\n", "   ", 
                 RowBox[{
                  RowBox[{"lead", "=", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Head", "[", "e", "]"}], "===", "Plus"}], ",", 
                    RowBox[{"First", "[", "e", "]"}], ",", "e"}], "]"}]}], ";",
                   "\n", "   ", 
                  RowBox[{"TrueQ", "[", 
                   RowBox[{"lead", "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Times", "[", 
                    RowBox[{
                    RowBox[{"k_", "?", "NumericQ"}], ",", "___"}], "]"}], ":>", 
                    RowBox[{"k", "<", "0"}]}], ",", 
                    RowBox[{
                    RowBox[{"k_", "?", "\n", "NumericQ"}], ":>", 
                    RowBox[{"k", "<", "0"}]}], ",", 
                    RowBox[{"_", ":>", "False"}]}], "}"}]}], "]"}]}]}], 
                "]"}]}], ";", "\n", "   ", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{
                "True", " ", "if", " ", "the", " ", "leading", " ", "term", " ",
                  "of", " ", "the", " ", "expanded", " ", "g\[Mu]\[Nu]", " ", 
                 "is", " ", "negative"}], ";", " ", 
                RowBox[{"handles", " ", "\[PlusMinus]", 
                 RowBox[{"1", " ", "too"}]}]}], " ", "*)"}], "\n", "\n", 
              RowBox[{"factor", "=", "1"}], ";", "\n", "\t", 
              RowBox[{"(*", " ", 
               RowBox[{
               "Factor", " ", "to", " ", "prevent", " ", "g\[Mu]\[Nu]", " ", 
                "from", " ", "being", " ", "negative", " ", "in", " ", 
                "nextTerm"}], " ", "*)"}], "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"negSign", "===", "True"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"plus", "=", "\"\< - \>\""}], ";", 
                 RowBox[{"factor", "=", 
                  RowBox[{"-", "1"}]}]}], ",", "\[IndentingNewLine]", 
                RowBox[{"plus", "=", "\"\< + \>\""}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"firstElem", "==", "1"}], ",", 
                RowBox[{
                 RowBox[{"firstElem", "=", "0"}], ";", 
                 RowBox[{"g\[Mu]\[Nu]", "=", 
                  RowBox[{"g", "[", 
                   RowBox[{"0", ",", "0"}], "]"}]}], ";", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"plus", "==", "\"\< + \>\""}], ",", 
                   RowBox[{"plus", "=", "\"\<\>\""}]}], "]"}]}]}], "]"}], ";",
               "\n", "\t", 
              RowBox[{"(*", " ", 
               RowBox[{"Suppress", " ", "+", " ", 
                RowBox[{
                "sign", " ", "on", " ", "a", " ", "first", " ", "term", " ", 
                 "that", " ", "is", " ", "positive"}]}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"g\[Mu]\[Nu]", "==", "1"}], ",", 
                RowBox[{"g\[Mu]\[Nu]", "=", "\"\<\>\""}]}], "]"}], ";", "\n", 
              
              RowBox[{"posTerm", "=", 
               RowBox[{
                RowBox[{"factor", " ", "g\[Mu]\[Nu]"}], "/.", 
                RowBox[{
                 RowBox[{"Times", "[", 
                  RowBox[{
                   RowBox[{"-", "1"}], ",", "x___", ",", "p_Plus", ",", 
                   "y___"}], "]"}], ":>", 
                 RowBox[{"Times", "[", 
                  RowBox[{"x", ",", 
                   RowBox[{"Expand", "[", 
                    RowBox[{"-", "p"}], "]"}], ",", "y"}], "]"}]}]}]}], ";", 
              "\n", "   ", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{
                "move", " ", "a", " ", "leftover", " ", "minus", " ", "into", 
                 " ", "a", " ", 
                 RowBox[{"sum", ":", " ", 
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{"p\.b2", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "-", "x"}], ")"}]}], ")"}]}]}]}], " ",
                 "->", " ", 
                RowBox[{"p\.b2", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", "x"}], ")"}]}]}], " ", "*)"}], "\n", "\n", 
              RowBox[{"Lparen", "=", "\"\<\>\""}], ";", "\n", 
              RowBox[{"Rparen", "=", "\"\<\>\""}], ";", "\n", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Head", "[", "g\[Mu]\[Nu]", "]"}], "==", "Plus"}], ",", 
                RowBox[{"Lparen", "=", "\"\<(\>\""}]}], "]"}], ";", " ", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"Put", " ", "sums", " ", "like"}], " ", "-", 
                SuperscriptBox["r", "2"], "+", 
                RowBox[{"\[Alpha]", " ", "in", " ", "parentheses"}]}], " ", 
               "*)"}], "\n", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Head", "[", "g\[Mu]\[Nu]", "]"}], "==", "Plus"}], ",", 
                RowBox[{"Rparen", "=", "\"\<)\>\""}]}], "]"}], ";", "\n", 
              RowBox[{"nextTerm", "=", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{
                 "Lparen", ",", "posTerm", ",", "Rparen", ",", "\"\< d\>\"", ",", 
                  RowBox[{"\[ScriptX]", "[", "\[Mu]", "]"}], ",", "\"\< d\>\"",
                   ",", 
                  RowBox[{"\[ScriptX]", "[", "\[Nu]", "]"}]}], "}"}], "]"}]}],
               ";", " ", "\[IndentingNewLine]", "\t\t\t", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"Next", " ", "off"}], "-", 
                RowBox[{
                "diagonal", " ", "line", " ", "element", " ", "term"}]}], " ",
                "*)"}], "\n", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"\[Mu]", "==", "\[Nu]"}], ",", 
                RowBox[{"nextTerm", "=", 
                 RowBox[{"Row", "[", 
                  RowBox[{"{", 
                   RowBox[{
                   "Lparen", ",", "posTerm", ",", "Rparen", ",", "\"\< d\>\"",
                     ",", 
                    SuperscriptBox[
                    RowBox[{"\[ScriptX]", "[", "\[Mu]", "]"}], "2"]}], "}"}], 
                  "]"}]}]}], "]"}], ";", " ", "\[IndentingNewLine]", "\t\t\t", 
              RowBox[{"(*", " ", 
               RowBox[{
               "Next", " ", "diagonal", " ", "line", " ", "element", " ", 
                "term"}], " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<nextTerm = \>\"", ",", "nextTerm"}], "]"}], 
                ";"}], "*)"}], "\n", "\n", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{"kount", ",", "4"}], "]"}], "==", "1"}], ",", "\n", 
                
                RowBox[{
                 RowBox[{"kount4", "=", 
                  RowBox[{"kount4", "+", "1"}]}], ";", "\n", 
                 RowBox[{
                  RowBox[{"line", "[", "kount4", "]"}], "=", "\"\<\>\""}]}]}],
                "]"}], ";", "  ", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"Initialize", " ", "new", " ", "row"}], " ", "=", " ",
                 "\[Phi]"}], " ", "*)"}], "\n", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<kount4 = \>\"", ",", "kount4"}], "]"}], ";"}], 
               "*)"}], "\n", "\n", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"kount4", "*", "kount"}], "==", "1"}], ",", "\n", 
                RowBox[{
                 RowBox[{"line", "[", "kount4", "]"}], "=", 
                 RowBox[{"Row", "[", 
                  RowBox[{"{", 
                   
                   RowBox[{"\"\<\!\(\*SuperscriptBox[\(ds\), \(2\)]\) = \>\"",
                     ",", "plus", ",", "nextTerm"}], "}"}], "]"}]}], ",", " ", 
                RowBox[{"(*", " ", 
                 RowBox[{
                  SuperscriptBox["ds", "2"], " ", "only", " ", "on", " ", 
                  "row", " ", "1"}], " ", "*)"}], "\n", 
                RowBox[{
                 RowBox[{"line", "[", "kount4", "]"}], "=", 
                 RowBox[{"Row", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"line", "[", "kount4", "]"}], ",", "plus", ",", 
                    "nextTerm"}], "}"}], "]"}]}]}], "]"}], ";", "  ", 
              RowBox[{"(*", " ", 
               RowBox[{"Else", ",", " ", 
                RowBox[{"append", " ", "new", " ", "term"}]}], " ", "*)"}], 
              " ", "\n", "\n", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"Print", "[", 
                 
                 RowBox[{"\"\<line(\>\"", ",", "kount4", ",", "\"\<) = \>\"", 
                  ",", 
                  RowBox[{"line", "[", "kount4", "]"}]}], "]"}], ";"}], 
               "*)"}], "\n", 
              RowBox[{"lineElem", "=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"kount4", "==", "1"}], ",", 
                 RowBox[{"line", "[", "1", "]"}], ",", 
                 RowBox[{"Column", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"line", "[", "i", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "kount4"}], "}"}]}], "]"}], "]"}]}], 
                "]"}]}]}]}], "]"}]}]}], "]"}]}], "]"}], ";", "\n", 
      "lineElem"}]}], "]"}]}], " ", "\n", 
  RowBox[{"(*", " ", 
