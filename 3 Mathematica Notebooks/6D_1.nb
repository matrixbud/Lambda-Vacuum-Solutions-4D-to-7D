   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Solving \>\"", ",", 
      RowBox[{
       RowBox[{"\[ScriptCapitalA]", "[", "t", "]"}], "/.", "rulesDot"}], 
      ",", "\"\< = \!\(\*SuperscriptBox[\(c\), \(2\)]\) yields\>\""}], "]"}], 
    ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at1", "=", 
     RowBox[{
      RowBox[{"a", "[", "t", "]"}], "/.", 
