   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Plugging \[ScriptCapitalA], \[CapitalBeta], \
\[GothicCapitalC], and \!\(\*SubscriptBox[\(\[GothicCapitalD]\), \(4\)]\) \
(but not a) from the GRW solution into the field equations yields:\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"\[Mu]", "=", "dimL"}], ",", 
      RowBox[{"\[Mu]", "\[LessEqual]", "dimH"}], ",", 
      RowBox[{"\[Mu]", "++"}], ",", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"\[Nu]", "=", "\[Mu]"}], ",", 
        RowBox[{"\[Nu]", "\[LessEqual]", "2"}], ",", 
        RowBox[{"\[Nu]", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"R", "[", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "===", 
             RowBox[{"\[CapitalLambda]", " ", 
              RowBox[{"g", "[", 
               RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}]}], ")"}]}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<R\>\"", ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\[Mu]", ",", "\[Mu]"}], "}"}], "]"}]}], "]"}], 
            ",", "\"\<:  \>\"", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"lhs", "[", 
               RowBox[{"\[Mu]", ",", "\[Mu]"}], "]"}], "/.", "rulesKr"}], "/.",
              " ", "rulesDisp"}], ",", "\"\< = \>\"", ",", 
            RowBox[{"rhs", "[", 
             RowBox[{"\[Mu]", ",", "\[Mu]"}], "]"}]}], "]"}]}], "]"}]}], 
       "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\!\(\*SubscriptBox[\(R\), \(22\)]\) is redundant, the \
same as \!\(\*SubscriptBox[\(R\), \(11\)]\).\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The Friedmann continuity and acceleration equations, \
respectively, are the following pair of equations generated by algebraic \
manipulation of \!\(\*SubscriptBox[\(R\), \(00\)]\) and \
\!\(\*SubscriptBox[\(R\), \(11\)]\):\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lhs01", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"lhs", "[", 
          RowBox[{"0", ",", "0"}], "]"}], 
         RowBox[{"n", 
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}]}]]}], "+", 
       FractionBox[
        RowBox[{"lhs", "[", 
         RowBox[{"1", ",", "1"}], "]"}], 
        RowBox[{"n", "-", "1"}]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhs01", "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"rhs", "[", 
         RowBox[{"0", ",", "0"}], "]"}], 
        RowBox[{"n", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}]]}], "+", 
      FractionBox[
       RowBox[{"rhs", "[", 
        RowBox[{"1", ",", "1"}], "]"}], 
       RowBox[{"n", "-", "1"}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \>\"", ",", 
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"n", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}]]}], 
      ",", "\"\<\!\(\*SubscriptBox[\(R\), \(00\)]\)+\>\"", ",", 
      FractionBox["1", 
       RowBox[{"n", "-", "1"}]], 
      ",", "\"\<\!\(\*SubscriptBox[\(R\), \(11\)]\):  \>\"", ",", 
      RowBox[{"lhs01", "/.", "rulesDisp"}], ",", "\"\< = \>\"", ",", 
      "rhs01"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lhs01b", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"lhs", "[", 
         RowBox[{"0", ",", "0"}], "]"}], 
        RowBox[{"n", "+", "1"}]], "+", 
       FractionBox[
        RowBox[{"lhs", "[", 
         RowBox[{"1", ",", "1"}], "]"}], 
        RowBox[{"n", "+", "1"}]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhs01b", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"rhs", "[", 
        RowBox[{"0", ",", "0"}], "]"}], 
       RowBox[{"n", "+", "1"}]], "+", 
      FractionBox[
       RowBox[{"rhs", "[", 
        RowBox[{"1", ",", "1"}], "]"}], 
       RowBox[{"n", "+", "1"}]]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<      \>\"", ",", 
      FractionBox["1", 
       RowBox[{"n", "+", "1"}]], 
      ",", "\"\<\!\(\*SubscriptBox[\(R\), \(00\)]\)+\>\"", ",", 
      FractionBox["1", 
       RowBox[{"n", "+", "1"}]], 
      ",", "\"\<\!\(\*SubscriptBox[\(R\), \(11\)]\):  \>\"", ",", 
      RowBox[{"lhs01b", "/.", "rulesDisp"}], ",", "\"\< = \>\"", ",", 
      "rhs01b"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<As pointed out earlier, \[ScriptCapitalA](t) = \
\!\(\*SuperscriptBox[\(c\), \(2\)]\) is simply a rearrangement of the \
continuity equation. Since the a(t) formula in Part a is the result of \
solving \[ScriptCapitalA](t) = \!\(\*SuperscriptBox[\(c\), \(2\)]\), the \
4-branch a(t) formula is also the solution to the Friedmann equations.\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
