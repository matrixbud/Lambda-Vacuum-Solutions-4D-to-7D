   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Case 6D_1 has two curled circles, parameterized by \
\!\(\*SubscriptBox[\(\[Psi]\), \(4\)]\) and \!\(\*SubscriptBox[\(\[Psi]\), \
\(5\)]\).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] The circles begin at \!\(\*SubscriptBox[\(\
\[Psi]\), \(\[Mu]\)]\)=0. Each winds around the circumference of a circle\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<    of radius \!\(\*SubscriptBox[\(p\), \(\[Mu]\)]\) \
and arrives back at the starting point at \!\(\*SubscriptBox[\(\[Psi]\), \(\
\[Mu]\)]\)=2\[Pi].\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] The circles thus have period 2\[Pi].\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";", 
    RowBox[{
    "Print", "[", "\"\<The GRW solution \
\!\(\*SubscriptBox[\(\[GothicCapitalD]\), \(5\)]\)(r) = 1 + \
\!\(\*FractionBox[\(\[Chi]\), \(r\)]\) ties the \
\!\(\*SubscriptBox[\(\[Psi]\), \(5\)]\) circle to r, even though they were \
initially unrelated. There is no such tie between the \!\(\*SubscriptBox[\(\
\[Psi]\), \(4\)]\) circle and r because \
\!\(\*SubscriptBox[\(\[GothicCapitalD]\), \(4\)]\)(r) = 1.\>\"", "]"}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Define \!\(\*SubscriptBox[\(r\), \(0\)]\) \[Congruent] \
-\[Chi].\>\"", "]"}], ";", 
    RowBox[{
    "Print", "[", "\"\<In order for \!\(\*SubscriptBox[\(\[GothicCapitalD]\), \
\(5\)]\)(r) = \!\(\*FractionBox[\(1\), \(\[CapitalBeta][r]\)]\) to be \
positive, we must have r > \!\(\*SubscriptBox[\(r\), \(0\)]\).\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Chi]", "=", 
     RowBox[{"-", "1.5"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
