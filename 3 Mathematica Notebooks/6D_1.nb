\\!\\(\\*StyleBox[\\\"base\\\",FontWeight->\\\"Bold\\\"]\\)\\!\\(\\*StyleBox[\
\\\" \\\",FontWeight->\\\"Bold\\\"]\\)\\!\\(\\*StyleBox[\\\"line\\\",\
