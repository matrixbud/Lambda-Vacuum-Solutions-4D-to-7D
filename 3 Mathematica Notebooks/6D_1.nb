       RowBox[{
        RowBox[{"Last", "[", 
         RowBox[{"DSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"0", ",", "0"}], "]"}], "==", 
            SuperscriptBox["c", "2"]}], ",", 
           RowBox[{"a", "[", "t", "]"}], ",", "t"}], "]"}], "]"}], "/.", 
        RowBox[{
         RowBox[{"C", "[", "1", "]"}], "->", "\[Alpha]"}]}], "]"}]}]}], ";"}],
