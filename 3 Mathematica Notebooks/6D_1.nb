Cell[BoxData["\<\"As r\[RightArrow]\\!\\(\\*SubscriptBox[\\(r\\), \
\\(0\\)]\\), the \\!\\(\\*SubscriptBox[\\(\[Psi]\\), \\(5\\)]\\)-circle \
