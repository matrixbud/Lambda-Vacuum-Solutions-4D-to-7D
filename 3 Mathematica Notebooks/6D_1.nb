    RowBox[{
    "Print", "[", \
"\"\<\!\(\*StyleBox[\"Approach\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\" \
\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"Overview\",FontWeight->\"Bold\"]\)\
\!\(\*StyleBox[\":\",FontWeight->\"Bold\"]\)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] Like 5D, it is too difficult to solve for \
FG GRW first, so we\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<    begin with GRW.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<    \[Checkmark] By letting \[GothicCapitalC](r) = 1, \
the equations are simplified and are solvable.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] The starting assumptions were derived in \
the appendix,\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<    which is a separate notebook.\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<    \[Checkmark] Initially, parameters k, A, \
