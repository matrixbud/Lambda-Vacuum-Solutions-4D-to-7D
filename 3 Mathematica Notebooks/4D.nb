   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Solving \>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"\[ScriptCapitalA]", "[", "t", "]"}], "/.", "rulesDisp"}], "//",
        "TraditionalForm"}], 
      ",", "\"\< = \!\(\*SuperscriptBox[\(c\), \(2\)]\)  for a(t) where \
\!\(\*OverscriptBox[\(a\), \(.\)]\) = \!\(\*FractionBox[\(da\), \
\(dt\)]\).\>\""}], "]"}], ";"}], " ", "\[IndentingNewLine]", "\[IndentingNewLine]", \

   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Recall the definitions of \
\!\(\*SuperscriptBox[\(cosh\), \(-1\)]\) and \!\(\*SuperscriptBox[\(sinh\), \
\(-1\)]\):\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<     \!\(\*SuperscriptBox[\(cosh\), \
\(-1\)]\)(\[Omega]) = \[Integral]\!\(\*FractionBox[\(d\[Omega]\), \
SqrtBox[\(\*SuperscriptBox[\(\[Omega]\), \(2\)] - 1\)]]\)  and  \
\!\(\*SuperscriptBox[\(sinh\), \(-1\)]\)(\[Omega]) = \
\[Integral]\!\(\*FractionBox[\(d\[Omega]\), SqrtBox[\(\*SuperscriptBox[\(\
\[Omega]\), \(2\)] + 1\)]]\)\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rs", "=", 
     RowBox[{
      SuperscriptBox["c", "2"], 
      RowBox[{"Simplify", "[", 
       RowBox[{
        FractionBox["1", "3"], 
        RowBox[{"Denominator", "[", 
         RowBox[{"\[ScriptCapitalA]", "[", "t", "]"}], "]"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rs2", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       SqrtBox["rs"], ",", 
       RowBox[{"c", ">", "0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"msg1", "=", "\"\<if k > 0\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"msg2", "=", "\"\<if k < 0\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"adot", "=", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"\[Piecewise]", GridBox[{
          {"\"\<\!\(\*SqrtBox[\( | \
\(k\)\(|\)\)]\)c\!\(\*SqrtBox[\(\*FractionBox[\(\[CapitalLambda]\), \(3 | k | \
\)] \*SuperscriptBox[\(a\), \(2\)] - 1\)]\)\>\"", "msg1"},
          {"\"\<\!\(\*SqrtBox[\( | \
\(k\)\(|\)\)]\)c\!\(\*SqrtBox[\(\*FractionBox[\(\[CapitalLambda]\), \(3 | k | \
\)] \*SuperscriptBox[\(a\), \(2\)] + 1\)]\)\>\"", "msg2"}
         }]}], ",", "TraditionalForm"}], "]"}]}], ";"}], "  ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<We begin with,\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \[ScriptCapitalA](t) = \>\"", ",", 
      RowBox[{
       RowBox[{"\[ScriptCapitalA]", "[", "t", "]"}], "/.", "rulesDisp"}], 
      ",", "\"\< = \!\(\*SuperscriptBox[\(c\), \(2\)]\)\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< \[Implies]   \!\(\*SuperscriptBox[OverscriptBox[\(a\), \(.\
\)], \(2\)]\) = \>\"", ",", 
      RowBox[{"rs", "/.", "rulesDisp"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< \[Implies]   \!\(\*FractionBox[\(da\), \(dt\)]\) = \
\!\(\*OverscriptBox[\(a\), \(.\)]\) = \>\"", ",", 
      RowBox[{"rs2", "/.", "rulesDisp"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<If k \[NotEqual] 0, this can be expressed\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \!\(\*FractionBox[\(da\), \(dt\)]\) = \
\!\(\*SqrtBox[\(k\)]\)c (\!\(\*SqrtBox[\(\*FractionBox[\(\[CapitalLambda]\), \
\(3  k\)] \*SuperscriptBox[\(a\), \(2\)] - 1\)]\)) = \>\"", ",", "adot"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<If we define\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<     \[Omega] = \!\(\*SqrtBox[FractionBox[\(\
\[CapitalLambda]\), \(3 | k | \)]]\)a,\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"adot2", "=", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"\[Piecewise]", GridBox[{
          {"\"\<\!\(\*SqrtBox[\( | \
\(k\)\(|\)\)]\)c\!\(\*SqrtBox[\(\*SuperscriptBox[\(\[Omega]\), \(2\)] - \
1\)]\)\>\"", "msg1"},
          {"\"\<\!\(\*SqrtBox[\( | \
\(k\)\(|\)\)]\)c\!\(\*SqrtBox[\(\*SuperscriptBox[\(\[Omega]\), \(2\)] + \
1\)]\)\>\"", "msg2"}
         }]}], ",", "TraditionalForm"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<then\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \!\(\*FractionBox[\(da\), \(dt\)]\) = \>\"", ",", 
      "adot2"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Differentiating both sides of the \[Omega] equations \
yields\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<     \!\(\*SqrtBox[\(\[CapitalLambda]\(\\\ \)\)]\)da = \
\!\(\*SqrtBox[\(3 | k | \)]\)d\[Omega]\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rs3", "=", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"\[Piecewise]", GridBox[{
          {"\"\<\!\(\*FractionBox[\(\*SqrtBox[\(\[CapitalLambda]\)] da\), \
SqrtBox[\(\*SuperscriptBox[\(\[Omega]\), \(2\)] - 1\)]]\) = \
\!\(\*SqrtBox[FractionBox[\(3 | k | \), SqrtBox[\(\*SuperscriptBox[\(\[Omega]\
\), \(2\)] - 1\)]]]\)d\[Omega]\>\"", "msg1"},
          {"\"\<\!\(\*FractionBox[\(\*SqrtBox[\(\[CapitalLambda]\)] da\), \
SqrtBox[\(\*SuperscriptBox[\(\[Omega]\), \(2\)] + 1\)]]\) = \
\!\(\*SqrtBox[FractionBox[\(3 | k | \), SqrtBox[\(\*SuperscriptBox[\(\[Omega]\
\), \(2\)] + 1\)]]]\)d\[Omega]\>\"", "msg2"}
         }]}], ",", "TraditionalForm"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rs3c", "=", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"\[Piecewise]", GridBox[{
          {"\"\<\!\(\*FractionBox[SqrtBox[\(3\)], SqrtBox[\(\*SuperscriptBox[\
\(\[Omega]\), \(2\)] - 1\)]]\)d\[Omega]\>\"", "msg1"},
          {"\"\<\!\(\*FractionBox[SqrtBox[\(3\)], SqrtBox[\(\*SuperscriptBox[\
\(\[Omega]\), \(2\)] + 1\)]]\)d\[Omega]\>\"", "msg2"}
         }]}], ",", "TraditionalForm"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Multiplying both sides of the \
\!\(\*FractionBox[\(da\), \(dt\)]\) equation by \!\(\*SqrtBox[\(\
\[CapitalLambda]\)]\)dt and rearranging, we get\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \!\(\*SqrtBox[\(\[CapitalLambda]\)]\)\!\(\*SqrtBox[\( \
| \(k\)\(|\)\)]\)c dt = \>\"", ",", 
      RowBox[{"rs3", "//", "TraditionalForm"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Since k \[NotEqual] 0, \!\(\*SqrtBox[\( | \
\(k\)\(|\)\)]\) can be divided out of both sides:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \!\(\*SqrtBox[\(\[CapitalLambda]\)]\) c dt = \>\"", ",",
       "rs3c"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "msg1a", "=", "\"\<if k > 0, \[CapitalLambda] \[NotEqual] 0\>\""}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"msg2a", "=", "\"\<if k < 0       \>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coshsinh", "=", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"\[Piecewise]", GridBox[{
          {"\"\<\!\(\*SqrtBox[\(3\)]\)\[Integral]\!\(\*FractionBox[\(d\[Omega]\
\), SqrtBox[\(\*SuperscriptBox[\(\[Omega]\), \(2\)] - 1\)]]\) = \
\!\(\*SqrtBox[\(3\)]\)\!\(\*SuperscriptBox[\(cosh\), \(-1\)]\)[\[Omega]] = \!\
\(\*SqrtBox[\(3\)]\)\!\(\*SuperscriptBox[\(cosh\), \
\(-1\)]\)[\!\(\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \(3\\\  | k | \
\)]]\)a]\>\"", "msg1"},
          {"\"\<\!\(\*SqrtBox[\(3\)]\)\[Integral]\!\(\*FractionBox[\(d\[Omega]\
\), SqrtBox[\(\*SuperscriptBox[\(\[Omega]\), \(2\)] + 1\)]]\) = \
\!\(\*SqrtBox[\(3\)]\)\!\(\*SuperscriptBox[\(sinh\), \(-1\)]\)[\[Omega]] = \!\
\(\*SqrtBox[\(3\)]\)\!\(\*SuperscriptBox[\(sinh\), \
\(-1\)]\)[\!\(\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \(3\\\  | k | \
\)]]\)a]\>\"", "msg2"}
         }]}], ",", "TraditionalForm"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coshsinh2a", "=", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"\[Piecewise]", GridBox[{
          {"\"\<\!\(\*SuperscriptBox[\(cosh\), \
\(-1\)]\)[\!\(\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \(3\\\  | k | \
\)]]\)a]\>\"", "msg1"},
          {"\"\<\!\(\*SuperscriptBox[\(sinh\), \
\(-1\)]\)[\!\(\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \(3\\\  | k | \
\)]]\)a]\>\"", "msg2"}
         }]}], ",", "TraditionalForm"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coshsinh3", "=", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"\[Piecewise]", GridBox[{
          {"\"\<cosh[\!\(\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \
\(3\)]]\)ct]\>\"", "msg1"},
          {"\"\<sinh[\!\(\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \
\(3\)]]\)ct]\>\"", "msg2"}
         }]}], ",", "TraditionalForm"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< \[Implies]   \!\(\*SqrtBox[\(\[CapitalLambda]\)]\) \>\"", ",", 
      RowBox[{"c", "  ", "t"}], 
      ",", "\"\< = \!\(\*SqrtBox[\(\[CapitalLambda]\)]\) c \[Integral]dt = \>\
\"", ",", 
      RowBox[{"coshsinh", "//", "TraditionalForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<     where the constant of integration, an offset, has \
been set to zero.\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< \[Implies]   \
\!\(\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \(3\)]]\)\>\"", ",", 
      RowBox[{"c", " ", "t"}], ",", "\"\< = \>\"", ",", "coshsinh2a"}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Eliminating the inverse functions, we get\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \>\"", ",", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\!\(\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \(3\\\  \
| k | \)]]\)\>\"", ",", "a"}], "}"}], "]"}], ",", "\"\< = \>\"", ",", 
      RowBox[{"coshsinh3", "//", "TraditionalForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<or\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     " ", "\"\<     \
\!\(\*StyleBox[\"(\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"1\",FontWeight->\
\"Bold\"]\)\!\(\*StyleBox[\")\",FontWeight->\"Bold\"]\)  a(t) = \
\!\(\*SqrtBox[FractionBox[\(3 | k | \), \
\(\[CapitalLambda]\)]]\)cosh[\!\(\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \
\(3\)]]\)ct]  if k > 0, \[CapitalLambda] \[NotEqual] 0\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     " ", "\"\<     \
\!\(\*StyleBox[\"(\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"2\",FontWeight->\
\"Bold\"]\)\!\(\*StyleBox[\")\",FontWeight->\"Bold\"]\)  a(t) = \
\!\(\*SqrtBox[FractionBox[\(3 | k | \), \
\(\[CapitalLambda]\)]]\)sinh[\!\(\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \
\(3\)]]\)ct]  if k < 0\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at1", "=", 
     RowBox[{
      SqrtBox[
       FractionBox[
        RowBox[{"3", 
         RowBox[{"Abs", "[", "k", "]"}]}], "\[CapitalLambda]"]], 
      RowBox[{"Cosh", "[", 
       RowBox[{
        SqrtBox[
         FractionBox["\[CapitalLambda]", "3"]], "c", " ", "t"}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"at2", "[", "t_", "]"}], "=", 
     RowBox[{
      FractionBox[
       SqrtBox[
        RowBox[{"3", 
         RowBox[{"Abs", "[", "k", "]"}]}]], 
       SqrtBox["\[CapitalLambda]"]], 
      RowBox[{"Sinh", "[", 
       RowBox[{
        SqrtBox[
         FractionBox["\[CapitalLambda]", "3"]], "c", " ", "t"}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Confirming:\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "[", "t_", "]"}], "=", "at1"}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{"or", " ", "=", "at2"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"\[Mu]", "=", "dimL"}], ",", 
       RowBox[{"\[Mu]", "\[LessEqual]", "dimH"}], ",", 
       RowBox[{"\[Mu]", "++"}], ",", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"\[Nu]", "=", "\[Mu]"}], ",", 
         RowBox[{"\[Nu]", "\[LessEqual]", "dimH"}], ",", 
         RowBox[{"\[Nu]", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<R\>\"", ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], "]"}]}], "]"}], 
           ",", "\"\<:  \>\"", ",", 
           RowBox[{
            RowBox[{"lhs", "[", 
             RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "/.", " ", "rulesDisp"}],
            ",", "\"\< = \>\"", ",", 
           RowBox[{"rhs", "[", 
            RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}], "]"}]}], "]"}]}], "]"}],
      ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"limSinh", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{
       FractionBox[
        RowBox[{" ", 
         RowBox[{"Sinh", "[", 
          RowBox[{"c", " ", 
           SqrtBox["\[CapitalLambda]"], " ", 
           RowBox[{"(", 
            FractionBox["t", 
             SqrtBox["3"]], ")"}]}], "]"}]}], 
        SqrtBox["\[CapitalLambda]"]], ",", 
       RowBox[{"\[CapitalLambda]", "->", "0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at3", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"at2", "[", "t", "]"}], ",", 
       RowBox[{"\[CapitalLambda]", "->", "0"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Formula (2) is valid when \[CapitalLambda] = 0:\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \!\(\*FractionBox[\(1\), \
SqrtBox[\(\[CapitalLambda]\)]]\)Sinh[\!\(\*SqrtBox[FractionBox[\(\
\[CapitalLambda]\), \(3\)]]\)ct] = \!\(\*UnderscriptBox[\(\\\ \(lim\)\), \(\
\[CapitalLambda] \[Rule] 0\)]\)\!\(\*FractionBox[\(\\\ \
\(Sinh[\*SqrtBox[FractionBox[\(\[CapitalLambda]\), \(3\)]]\\\ c\\\ t]\)\), \
SqrtBox[\(\[CapitalLambda]\)]]\) = \>\"", ",", "limSinh", 
      ",", "\"\<  due to L'Hospital's Rule\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<which implies\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \
\!\(\*StyleBox[\"(\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"3\",FontWeight->\
\"Bold\"]\)\!\(\*StyleBox[\")\",FontWeight->\"Bold\"]\)  a(t) = \>\"", ",", 
      RowBox[{"at3", "//", "TraditionalForm"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at4", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "[", "t", "]"}], "/.", 
       RowBox[{"Last", "[", 
        RowBox[{"DSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"0", ",", "0"}], "]"}], "/.", 
             RowBox[{"k", "->", "0"}]}], ")"}], "==", 
           SuperscriptBox["c", "2"]}], ",", 
          RowBox[{"a", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}], "/.", 
      RowBox[{
       RowBox[{"C", "[", "1", "]"}], "->", "\[Alpha]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<In finding solutions (1\[Dash]3) we have assumed k \
\[NotEqual] 0. When k = 0 (flat space), \[ScriptCapitalA](t) = \
\!\(\*SuperscriptBox[\(c\), \(2\)]\) becomes:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \[ScriptCapitalA](t) = \>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"\[ScriptCapitalA]", "[", "t", "]"}], "/.", 
        RowBox[{"k", "->", "0"}]}], "/.", "rulesDisp"}], 
      ",", "\"\< = \!\(\*SuperscriptBox[\(c\), \(2\)]\)\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<The result is\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<     \
\!\(\*StyleBox[\"(\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"4\",FontWeight->\
\"Bold\"]\)\!\(\*StyleBox[\")\",FontWeight->\"Bold\"]\)  a(t) = \>\"", ",", 
      RowBox[{"at4", "/.", 
       RowBox[{
        SuperscriptBox["E", "x_"], "->", 
        SuperscriptBox["E", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<\[PlusMinus]\>\"", ",", "x"}], "}"}], "]"}]]}]}], 
      ",", "\"\<  where \[Alpha] is a constant of integration\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "msg1b", "=", \
"\"\<\!\(\*StyleBox[\"if\",FontColor->RGBColor[0.00006103608758678569, \
