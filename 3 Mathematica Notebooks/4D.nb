             SuperscriptBox["E", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<\[PlusMinus]\>\"", ",", "x"}], "}"}], "]"}]]}]}],
            "msg4b"}
