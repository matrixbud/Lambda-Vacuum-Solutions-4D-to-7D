Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"     \[CapitalBeta](r) = \"\>", "\[InvisibleSpace]", 
   TagBox[
    FormBox[
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", " ", 
           RowBox[{
            SuperscriptBox["\[GothicCapitalC]", "\[Prime]",
             MultilineFunction->None], "(", "r", ")"}]}], "+", 
          RowBox[{"2", " ", 
           RowBox[{"\[GothicCapitalC]", "(", "r", ")"}]}]}], ")"}], "2"], 
       RowBox[{"4", " ", 
        RowBox[{"\[GothicCapitalC]", "(", "r", ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", " ", 
           SuperscriptBox["r", "2"], " ", 
           RowBox[{"\[GothicCapitalC]", "(", "r", ")"}]}], "-", "1"}], 
         ")"}]}]]}],
     TraditionalForm],
    TraditionalForm,
    Editable->True]}],
  SequenceForm["     \[CapitalBeta](r) = ", 
   TraditionalForm[
   Rational[-1, 
      4] $CellContext`\[GothicCapitalC][$CellContext`r]^(-1) (-1 + \
$CellContext`k $CellContext`r^2 \
$CellContext`\[GothicCapitalC][$CellContext`r])^(-1) (
      2 $CellContext`\[GothicCapitalC][$CellContext`r] + $CellContext`r 
       Derivative[1][$CellContext`\[GothicCapitalC]][$CellContext`r])^2]],
  Editable->False]], "Print",
 CellChangeTimes->{
