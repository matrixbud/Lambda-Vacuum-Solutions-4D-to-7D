    "Print", "[", \
"\"\<\!\(\*StyleBox[\"Observation\",FontColor->RGBColor[0.\
00006103608758678569, 0.0018005645838101779`, 0.9982299534599832]]\):\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\< \[Bullet] The \[CapitalBeta](r) = \
\!\(\*FractionBox[\(1\), \(1 - k\\\ \*SuperscriptBox[\(r\), \(2\)]\)]\) FLRW \
metric term requires a reduced domain,\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<   \!\(\*SuperscriptBox[\(kr\), \(2\)]\) < 1, in order \
that \[CapitalBeta](r) > 0.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\< \[Bullet] This is known as \
