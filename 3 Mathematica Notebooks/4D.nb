Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"     \[ScriptCapitalA][t] = \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{"3", " ", 
     SuperscriptBox[
      RowBox[{
       OverscriptBox["a", "."], "[", "t", "]"}], "2"]}], 
    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], " ", "k"}], "+", 
     RowBox[{"\[CapitalLambda]", " ", 
      SuperscriptBox[
       RowBox[{"a", "[", "t", "]"}], "2"]}]}]], 
   "\[InvisibleSpace]", "\<\",  where k is a free constant,\"\>"}],
  SequenceForm[
  "     \[ScriptCapitalA][t] = ", 
   3 ((-3) $CellContext`k + $CellContext`\[CapitalLambda] \
$CellContext`a[$CellContext`t]^2)^(-1) 
   OverDot[$CellContext`a, 1][$CellContext`t]^2, 
   ",  where k is a free constant,"],
  Editable->False]], "Print",
