Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"     \\!\\(\\*SubscriptBox[\\(R\\), \
\\(11\\)]\\)-2\\!\\(\\*SubscriptBox[\\(R\\), \\(22\\)]\\):  \"\>", "\[InvisibleSpace]", 
   TagBox[
    FormBox[
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", "k"}], 
       SuperscriptBox["a", "2"]], "+", 
      FractionBox["2", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", "\[CapitalBeta]", " ", 
        SuperscriptBox["r", "2"]}]], "-", 
      FractionBox["2", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["r", "2"], " ", "\[GothicCapitalC]"}]], "+", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["\[GothicCapitalC]", "\[Prime]",
         MultilineFunction->None]}], 
       RowBox[{
        SuperscriptBox["a", "2"], " ", "\[CapitalBeta]", " ", "r", " ", 
        "\[GothicCapitalC]"}]], "+", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["\[GothicCapitalC]", "\[Prime]",
          MultilineFunction->None], ")"}], "2"], 
       RowBox[{"2", " ", 
        SuperscriptBox["a", "2"], " ", "\[CapitalBeta]", " ", 
        SuperscriptBox["\[GothicCapitalC]", "2"]}]], "-", "\[CapitalLambda]"}],
     TraditionalForm],
    TraditionalForm,
    Editable->True], "\[InvisibleSpace]", "\<\" = \"\>", "\[InvisibleSpace]", 
   
   RowBox[{"-", "\[CapitalLambda]"}]}],
  SequenceForm[
  "     \!\(\*SubscriptBox[\(R\), \(11\)]\)-2\!\(\*SubscriptBox[\(R\), \
\(22\)]\):  ", 
   TraditionalForm[
   2 $CellContext`a^(-2) $CellContext`k - 
    2 $CellContext`a^(-2) $CellContext`r^(-2)/$CellContext`\[GothicCapitalC] + 
    2 $CellContext`a^(-2) $CellContext`r^(-2)/$CellContext`\[CapitalBeta] - \
$CellContext`\[CapitalLambda] + 
    2 $CellContext`a^(-2) $CellContext`r^(-1) \
$CellContext`\[GothicCapitalC]^(-1) $CellContext`\[CapitalBeta]^(-1) 
     Derivative[1][$CellContext`\[GothicCapitalC]] + 
    Rational[1, 
       2] $CellContext`a^(-2) $CellContext`\[GothicCapitalC]^(-2) \
$CellContext`\[CapitalBeta]^(-1) 
     Derivative[1][$CellContext`\[GothicCapitalC]]^2], 
   " = ", -$CellContext`\[CapitalLambda]],
  Editable->False]], "Print",
 CellChangeTimes->{
  3.9991000055570383`*^9, 3.999332274695044*^9, {3.999332378529189*^9, 
