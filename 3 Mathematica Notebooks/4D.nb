Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"     \[ScriptCapitalA](t) = \"\>", "\[InvisibleSpace]", 
   TagBox[
    FormBox[
     FractionBox[
      RowBox[{"3", " ", 
       SuperscriptBox[
        RowBox[{
         OverscriptBox["a", "."], "(", "t", ")"}], "2"]}], 
      RowBox[{
       RowBox[{"\[CapitalLambda]", " ", 
        SuperscriptBox[
         RowBox[{"a", "(", "t", ")"}], "2"]}], "-", 
       RowBox[{"3", " ", "k"}]}]],
     TraditionalForm],
    TraditionalForm,
    Editable->True], 
   "\[InvisibleSpace]", "\<\"  where k\[Element]\[DoubleStruckCapitalR] is a \
constant of integration.\"\>"}],
  SequenceForm["     \[ScriptCapitalA](t) = ", 
   TraditionalForm[
   3 ((-3) $CellContext`k + $CellContext`\[CapitalLambda] \
$CellContext`a[$CellContext`t]^2)^(-1) 
    OverDot[$CellContext`a, 1][$CellContext`t]^2], 
   "  where k\[Element]\[DoubleStruckCapitalR] is a constant of integration."],
  Editable->False]], "Print",
 CellChangeTimes->{
  3.9991000055570383`*^9, 3.999332274695044*^9, {3.999332378529189*^9, 
