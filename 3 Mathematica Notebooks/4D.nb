   RowBox[{
    RowBox[{
    "msg4b", "=", "\"\<if k = 0 & \[CapitalLambda] \[GreaterEqual] 0, where \
\[Alpha] > 0 is a free constant\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"toS", "=", 
