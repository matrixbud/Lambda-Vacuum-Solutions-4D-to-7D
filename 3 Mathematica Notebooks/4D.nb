\>", "\[InvisibleSpace]", 
   RowBox[{
    FractionBox["k", 
     RowBox[{"2", " ", 
      SuperscriptBox["a", "2"]}]], "+", 
    FractionBox[
     SuperscriptBox[
      OverscriptBox["a", "."], "2"], 
