Cell["\<\
In general K is (1 \[Minus] 2m/r)^(2s) / (r \[Minus] 2m)^4 times a \
polynomial. Points on the solution curve where that polynomial vanishes at r \
= 2m (the only places where K can stay finite): \
\>", "CodeText",ExpressionUUID->"68b1efc2-642f-49c3-8e2b-e1f403d82c51"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"poly", "=", 
   RowBox[{"Numerator", "[", 
    RowBox[{"Together", "[", 
     RowBox[{"K", " ", 
      RowBox[{"r", "^", "4"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"r", "-", 
          RowBox[{"2", " ", "m"}]}], ")"}], "^", "4"}], "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", 
         RowBox[{"m", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"2", " ", 
             RowBox[{"m", "/", "r"}]}]}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"e4", "+", "e5"}], ")"}]}], ")"}]}]}], ")"}]}]}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"poly", " ", "/.", " ", 
        RowBox[{"r", "->", 
         RowBox[{"2", " ", "m"}]}]}], ")"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"e4", "^", "2"}], "+", 
       RowBox[{"e4", " ", "e5"}], "+", 
       RowBox[{"e5", "^", "2"}]}], "==", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"e4", ",", "e5"}], "}"}], ",", "Reals"}], "]"}]}], "Input",
 CellLabel->
  "In[3897]:=",ExpressionUUID->"c324d8cc-96a1-4dfc-b899-00c11ceec291"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"e4", "\[Rule]", "0"}], ",", 
     RowBox[{"e5", "\[Rule]", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"e4", "\[Rule]", "1"}], ",", 
     RowBox[{"e5", "\[Rule]", "0"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.001271818689251*^9},
 CellLabel->
  "Out[3898]=",ExpressionUUID->"b97f519e-aa50-42e1-a337-185d2de546d7"]
}, Open  ]],

Cell["\<\
Numerical values of K approaching r = 2m (with m = 1/2) at four points on the \
solution curve: \
\>", "CodeText",ExpressionUUID->"2dedbbdd-b8a9-4108-9e5c-2fda452e707e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pt", "[", "s0_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"s0", "^", "2"}], "/", "4"}], "-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"s0", "^", "2"}], "-", "1"}], ")"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"s0", "/", "2"}], "+", "d"}], ",", 
       RowBox[{
        RowBox[{"s0", "/", "2"}], "-", "d"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", "=", 
         RowBox[{"pt", "[", "s0", "]"}]}], "}"}], ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s0", ",", 
           RowBox[{"N", "[", 
            RowBox[{"e", ",", "3"}], "]"}]}], "}"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"ScientificForm", "[", 
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"K", " ", "/.", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"e4", "->", 
                  RowBox[{"e", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                 RowBox[{"e5", "->", 
                  RowBox[{"e", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                 RowBox[{"m", "->", 
                  RowBox[{"1", "/", "2"}]}], ",", 
                 RowBox[{"r", "->", 
                  RowBox[{"1", "+", "eps"}]}]}], "}"}]}], "]"}], ",", "2"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"eps", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"1", "/", "10"}], ",", 
               RowBox[{"1", "/", "100"}], ",", 
               RowBox[{"1", "/", "1000"}], ",", 
               RowBox[{"1", "/", "10000"}]}], "}"}]}], "}"}]}], "]"}]}], 
        "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"s0", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"11", "/", "10"}], ",", 
         RowBox[{"3", "/", "5"}], ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}]}], "}"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<s\>\"", ",", "\"\<(e4, e5)\>\"", ",", "\"\<r-2m = 0.1\>\"",
         ",", "\"\<0.01\>\"", ",", "\"\<0.001\>\"", ",", "\"\<0.0001\>\""}], 
       "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[3899]:=",ExpressionUUID->"81daa09d-018f-474c-8661-d23229699d6b"],

