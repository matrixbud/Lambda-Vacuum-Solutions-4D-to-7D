Notebook[{

Cell[CellGroupData[{
Cell["Torus Solutions Beyond GRW: verification notebook", "Title",ExpressionUUID->"c4fb242d-7e21-4f6c-b30d-2287a5a70835"],

Cell[TextData[{
 StyleBox["Generated by Claude (Anthropic) to accompany the supplement \
\"Torus Solutions Beyond the GRW Assumption\". Bud Simrin's part was the \
series of questions that led to it. He did not check the derivations \
himself, but he ran this notebook, and its outputs match the supplement.",
  FontSlant->Italic],
 "This notebook checks the two main claims of the supplement for two curled \
circles (the 6D_1 setting, with k = 0):"
}], "Text",ExpressionUUID->"28f51909-5a50-46a0-ba75-a7e4806a1e04"],

Cell["\<\
1. The spatial metric below is Ricci-flat exactly when e4\.b2 + e4 e5 + \
e5\.b2 = 1, which is the same as s\.b2 + e4\.b2 + e5\.b2 = 2 with s = e4 + e5.\
\>", "Text",ExpressionUUID->"9d1942e2-fa8a-4419-b69b-da43dca09748"],

Cell["\<\
2. Its curvature (the Kretschmann invariant) stays finite at r = 2m only at \
(e4, e5) = (1, 0) and (0, 1), the GRW solutions of the 6D_1 notebook.\
\>", "Text",ExpressionUUID->"0c194337-2aec-435c-a523-6addd5939a3c"],

Cell["\<\
Evaluate the cells from top to bottom. The Riemann tensor step takes up to a \
minute or so. \
\>", "Text",ExpressionUUID->"d93ba255-22b3-46d8-a990-74de5295d97f"],

Cell[CellGroupData[{

Cell["Metric", "Section",ExpressionUUID->"1c0e3661-f95a-46e2-8775-ea6473397053"],

Cell["\<\
Spatial metric h, with f = 1 \[Minus] 2m/r (so \[Chi] = \[Minus]2m) and s = \
e4 + e5: \
\>", "CodeText",ExpressionUUID->"8ca5e796-78b4-4fb4-845d-f5df2eebe55f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"{", 
    RowBox[{
    "r", ",", "\[Theta]", ",", "\[Phi]", ",", "\[Psi]4", ",", "\[Psi]5"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{"1", "-", 
    RowBox[{"2", " ", 
     RowBox[{"m", "/", "r"}]}]}]}], ";", " ", 
  RowBox[{"s", "=", 
   RowBox[{"e4", "+", "e5"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"f", "^", 
       RowBox[{"-", "s"}]}], ",", 
      RowBox[{
       RowBox[{"f", "^", 
        RowBox[{"(", 
         RowBox[{"1", "-", "s"}], ")"}]}], " ", 
       RowBox[{"r", "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"f", "^", 
        RowBox[{"(", 
         RowBox[{"1", "-", "s"}], ")"}]}], " ", 
       RowBox[{"r", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"f", "^", "e4"}], " ", 
       RowBox[{"p4", "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"f", "^", "e5"}], " ", 
       RowBox[{"p5", "^", "2"}]}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gi", "=", 
   RowBox[{"Inverse", "[", "g", "]"}]}], ";", " ", 
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "coords", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"g", " ", "//", " ", "MatrixForm"}]}], "Input",
 CellLabel->
  "In[3882]:=",ExpressionUUID->"84c79742-e137-46ba-aadf-76cfbc54f87e"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"2", " ", "m"}], "r"]}], ")"}], 
       RowBox[{
        RowBox[{"-", "e4"}], "-", "e5"}]], "0", "0", "0", "0"},
     {"0", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"2", " ", "m"}], "r"]}], ")"}], 
        RowBox[{"1", "-", "e4", "-", "e5"}]], " ", 
       SuperscriptBox["r", "2"]}], "0", "0", "0"},
     {"0", "0", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"2", " ", "m"}], "r"]}], ")"}], 
        RowBox[{"1", "-", "e4", "-", "e5"}]], " ", 
       SuperscriptBox["r", "2"], " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "0", "0"},
     {"0", "0", "0", 
      RowBox[{
       SuperscriptBox["p4", "2"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"2", " ", "m"}], "r"]}], ")"}], "e4"]}], "0"},
     {"0", "0", "0", "0", 
      RowBox[{
       SuperscriptBox["p5", "2"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"2", " ", "m"}], "r"]}], ")"}], "e5"]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{4.001271756656727*^9},
 CellLabel->
  "Out[3887]//MatrixForm=",ExpressionUUID->"0a90e000-2d38-4c8d-aac8-\
88951347ce7d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Christoffel symbols and Ricci tensor", "Section",ExpressionUUID->"fb524c20-b1d8-494c-9bf7-fce50ce32ef7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalGamma]", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gi", "[", 
          RowBox[{"[", 
           RowBox[{"a", ",", "d"}], "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{"d", ",", "b"}], "]"}], "]"}], ",", 
             RowBox[{"coords", "[", 
              RowBox[{"[", "c", "]"}], "]"}]}], "]"}], "+", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{"d", ",", "c"}], "]"}], "]"}], ",", 
             RowBox[{"coords", "[", 
              RowBox[{"[", "b", "]"}], "]"}]}], "]"}], "-", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{"b", ",", "c"}], "]"}], "]"}], ",", 
             RowBox[{"coords", "[", 
              RowBox[{"[", "d", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "n"}], "}"}]}], "]"}], "/", "2"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ric", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[CapitalGamma]", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", "b", ",", "c"}], "]"}], "]"}], ",", 
          RowBox[{"coords", "[", 
           RowBox[{"[", "a", "]"}], "]"}]}], "]"}], "-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[CapitalGamma]", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", "b", ",", "a"}], "]"}], "]"}], ",", 
          RowBox[{"coords", "[", 
           RowBox[{"[", "c", "]"}], "]"}]}], "]"}], "+", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{"[", 
              RowBox[{"a", ",", "a", ",", "d"}], "]"}], "]"}], " ", 
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{"[", 
              RowBox[{"d", ",", "b", ",", "c"}], "]"}], "]"}]}], "-", 
           RowBox[{
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{"[", 
              RowBox[{"a", ",", "c", ",", "d"}], "]"}], "]"}], " ", 
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{"[", 
              RowBox[{"d", ",", "b", ",", "a"}], "]"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "n"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "n"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "n"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[3888]:=",ExpressionUUID->"656bdc97-9b4b-4a03-b76f-930a3f2ac97f"],

Cell["\<\
Off-diagonal components (all zero) and the diagonal components: \
\>", "CodeText",ExpressionUUID->"ad28e06b-7e3a-4dbd-9728-c728c651e88e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Union", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Simplify", "[", 
      RowBox[{"ric", "-", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Diagonal", "[", "ric", "]"}], "]"}]}], "]"}], "]"}], "]"}], ",", 
   RowBox[{"Factor", " ", "/@", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Diagonal", "[", "ric", "]"}], ",", 
      RowBox[{
       RowBox[{"m", ">", "0"}], "&&", 
       RowBox[{"r", ">", 
        RowBox[{"2", " ", "m"}]}]}]}], "]"}]}]}], "}"}]], "Input",
 CellLabel->
  "In[3890]:=",ExpressionUUID->"21d39961-4697-42d7-9f24-89a0a9ac8033"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["e4", "2"], "+", 
          RowBox[{"e4", " ", "e5"}], "+", 
          SuperscriptBox["e5", "2"]}], ")"}], " ", 
        SuperscriptBox["m", "2"]}], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "m"}], "-", "r"}], ")"}], "2"], " ", 
        SuperscriptBox["r", "2"]}]]}], ",", "0", ",", "0", ",", "0", ",", 
     "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.001271784556189*^9},
 CellLabel->
  "Out[3890]=",ExpressionUUID->"464120fc-be53-477a-9bae-c5912d8138fb"]
}, Open  ]],

Cell["\<\
Only R_11 (the radial component; index 1 is r) is nonzero, and it vanishes \
exactly when e4\.b2 + e4 e5 + e5\.b2 = 1. \
\>", "Text",ExpressionUUID->"04835d5e-ede9-4b67-a733-c125d4d4f71a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The GRW (s = 1) solutions are special cases", "Section",ExpressionUUID->"9a0d669f-4acd-4fff-87ac-b3dab0eab1a4"],

Cell["\<\
With e5 = 1 \[Minus] e4 (so s = 1), the condition becomes e4(e4 \[Minus] 1) = \
0: \
\>", "CodeText",ExpressionUUID->"aa6f53a7-379a-4f9e-ba8e-e82dfb75bd07"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Factor", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"e4", "^", "2"}], "+", 
     RowBox[{"e4", " ", "e5"}], "+", 
     RowBox[{"e5", "^", "2"}], "-", "1"}], ")"}], " ", "/.", " ", 
   RowBox[{"e5", "->", 
    RowBox[{"1", "-", "e4"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[3891]:=",ExpressionUUID->"714d608d-8116-4763-9b20-07dd82715d3e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "e4"}], ")"}], " ", "e4"}]], "Output",
 CellChangeTimes->{4.001271800356432*^9},
 CellLabel->
  "Out[3891]=",ExpressionUUID->"fa61f779-9495-49d7-8742-cc0f88e063a6"]
}, Open  ]]
