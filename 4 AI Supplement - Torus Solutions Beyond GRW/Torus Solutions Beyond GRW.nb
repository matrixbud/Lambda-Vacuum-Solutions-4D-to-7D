Cell[CellGroupData[{

Cell["Kretschmann invariant", "Section",ExpressionUUID->"20c94878-0bfa-415d-93b1-d4d7b9fc87ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"riem", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", 
         RowBox[{"[", 
          RowBox[{"a", ",", "b", ",", "d"}], "]"}], "]"}], ",", 
        RowBox[{"coords", "[", 
         RowBox[{"[", "c", "]"}], "]"}]}], "]"}], "-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", 
         RowBox[{"[", 
          RowBox[{"a", ",", "b", ",", "c"}], "]"}], "]"}], ",", 
        RowBox[{"coords", "[", 
         RowBox[{"[", "d", "]"}], "]"}]}], "]"}], "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalGamma]", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", "c", ",", "k"}], "]"}], "]"}], " ", 
          RowBox[{"\[CapitalGamma]", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "b", ",", "d"}], "]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"\[CapitalGamma]", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", "d", ",", "k"}], "]"}], "]"}], " ", 
          RowBox[{"\[CapitalGamma]", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "b", ",", "c"}], "]"}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"low", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"[", 
          RowBox[{"a", ",", "k"}], "]"}], "]"}], " ", 
        RowBox[{"riem", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "b", ",", "c", ",", "d"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "n"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"up", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"gi", "[", 
       RowBox[{"[", 
        RowBox[{"b", ",", "b"}], "]"}], "]"}], " ", 
      RowBox[{"gi", "[", 
       RowBox[{"[", 
        RowBox[{"c", ",", "c"}], "]"}], "]"}], " ", 
      RowBox[{"gi", "[", 
       RowBox[{"[", 
        RowBox[{"d", ",", "d"}], "]"}], "]"}], " ", 
      RowBox[{"riem", "[", 
       RowBox[{"[", 
        RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"K", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"low", " ", "up"}], "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"m", ">", "0"}], "&&", 
     RowBox[{"r", ">", 
      RowBox[{"2", " ", "m"}]}]}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[3892]:=",ExpressionUUID->"10b8173b-56f0-43cf-8886-f1e4a58d358d"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{
    SuperscriptBox["r", "4"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "m"}], "+", "r"}], ")"}], "4"]}]], 
