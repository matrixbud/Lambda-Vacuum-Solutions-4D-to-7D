              "\[IndentingNewLine]", 
              RowBox[{"dx\[Nu]", "=", 
               RowBox[{"\"\<d\>\"", "<>", "x\[Nu]"}]}], ";", 
              "\[IndentingNewLine]", "\n", 
              RowBox[{"negSign", "=", 
               RowBox[{"g\[Mu]\[Nu]", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Times", "[", 
                    RowBox[{
                    RowBox[{"c_", "?", "NumericQ"}], ",", "___"}], "]"}], ":>", 
                   RowBox[{"c", "<", "0"}]}], ",", 
                  RowBox[{"_Times", ":>", "False"}]}], "}"}]}]}], ";", " ", 
              "\n", "\t", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"=", " ", 
                 RowBox[{
                 "True", " ", "if", " ", "g\[Mu]\[Nu]", " ", "starts", " ", 
                  "with", " ", "neg", " ", "sign"}]}], ",", "  ", 
                RowBox[{"random", " ", "values", " ", 
                 RowBox[{"o", ".", "w", "."}]}]}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Head", "[", "g\[Mu]\[Nu]", "]"}], "===", 
                 "Integer"}], ",", 
                RowBox[{
                 RowBox[{"negSign", "=", "False"}], ";", " ", 
                 "\[IndentingNewLine]", "\t", 
                 RowBox[{"(*", " ", 
                  RowBox[{
                   RowBox[{"Special", " ", 
                    RowBox[{"case", ":", " ", 
                    RowBox[{"give", " ", "g\[Mu]\[Nu]"}]}]}], " ", "=", " ", 
                   RowBox[{"1", " ", "a", " ", "False", " ", "value"}]}], 
                  "  ", "*)"}], "\n", "\t", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"g\[Mu]\[Nu]", "<", "0"}], ",", 
                   RowBox[{"negSign", "=", "True"}]}], "]"}]}]}], 
               "\[IndentingNewLine]", "\t", 
               RowBox[{"(*", " ", 
                RowBox[{
                 RowBox[{"Special", " ", 
                  RowBox[{"case", ":", " ", 
                   RowBox[{"give", " ", "g\[Mu]\[Nu]"}]}]}], "=", " ", 
                 RowBox[{
                  RowBox[{"-", "1"}], " ", "a", " ", "True", " ", "value"}]}],
                 "  ", "*)"}], "\[IndentingNewLine]", "]"}], ";", "\n", "\n", 
              
              RowBox[{"factor", "=", "1"}], ";", "\[IndentingNewLine]", "\t", 
              
              RowBox[{"(*", " ", 
               RowBox[{
               "Factor", " ", "to", " ", "prevent", " ", "g\[Mu]\[Nu]", " ", 
                "from", " ", "being", " ", "negative", " ", "in", " ", 
                "nextTerm"}], " ", "*)"}], "\[IndentingNewLine]", "\n", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"negSign", "===", "True"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"plus", "=", "\"\< - \>\""}], ";", 
                 RowBox[{"factor", "=", 
                  RowBox[{"-", "1"}]}]}], ",", "\[IndentingNewLine]", 
                RowBox[{"plus", "=", "\"\< + \>\""}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"firstElem", "==", "1"}], ",", 
                RowBox[{
                 RowBox[{"firstElem", "=", "0"}], ";", 
                 RowBox[{"g\[Mu]\[Nu]", "=", 
                  RowBox[{"g", "[", 
                   RowBox[{"0", ",", "0"}], "]"}]}], ";", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"plus", "==", "\"\< + \>\""}], ",", 
                   RowBox[{"plus", "=", "\"\<\>\""}]}], "]"}]}]}], "]"}], ";",
               "\n", "\t", 
              RowBox[{"(*", " ", 
               RowBox[{"Suppress", " ", "+", " ", 
                RowBox[{
                "sign", " ", "on", " ", "a", " ", "first", " ", "term", " ", 
                 "that", " ", "is", " ", "positive"}]}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"g\[Mu]\[Nu]", "==", "1"}], ",", 
                RowBox[{"g\[Mu]\[Nu]", "=", "\"\<\>\""}]}], "]"}], ";", 
              "\[IndentingNewLine]", "\n", 
              RowBox[{"nextTerm", "=", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"factor", " ", "g\[Mu]\[Nu]"}], ",", "\"\< \>\"", ",",
                   "dx\[Mu]", ",", "\"\< \>\"", ",", "dx\[Nu]"}], "}"}], 
                "]"}]}], ";", " ", "\n", "\t\t\t", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"Next", " ", "off"}], "-", 
                RowBox[{
                "diagonal", " ", "line", " ", "element", " ", "term"}]}], " ",
                "*)"}], "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"\[Mu]", "==", "\[Nu]"}], ",", 
                RowBox[{"nextTerm", "=", 
                 RowBox[{"Row", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"factor", " ", "g\[Mu]\[Nu]"}], ",", "\"\< d\>\"",
                     ",", 
                    SuperscriptBox[
                    RowBox[{"\[ScriptX]", "[", "\[Mu]", "]"}], "2"]}], "}"}], 
                  "]"}]}]}], "]"}], ";", " ", "\[IndentingNewLine]", "\t\t\t", 
              RowBox[{"(*", " ", 
               RowBox[{
               "Next", " ", "diagonal", " ", "line", " ", "element", " ", 
                "term"}], " ", "*)"}], "\n", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"lineElem", "=", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{"lineElem", ",", "plus", ",", "nextTerm"}], "}"}], 
                "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}]}], "]"}]}], "]"}],
       ";", "\n", "lineElem"}]}], "]"}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"end", " ", "of", " ", "module"}], " ", "*)"}], "\n"}], "\n", 
