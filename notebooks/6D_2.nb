0.5002822919050889, \
0.0328526741435874]]\)\!\(\*StyleBox[\"space\",FontWeight->\"Bold\",FontColor-\
>RGBColor[0.9904173342488747, 0.5002822919050889, \
0.0328526741435874]]\)\!\(\*StyleBox[\" \
\",FontWeight->\"Bold\",FontColor->RGBColor[0.9904173342488747, \
0.5002822919050889, \
0.0328526741435874]]\)\!\(\*StyleBox[\"ties\",FontWeight->\"Bold\",FontColor->\
RGBColor[0.9904173342488747, 0.5002822919050889, \
0.0328526741435874]]\)\!\(\*StyleBox[\" \
\",FontWeight->\"Bold\",FontColor->RGBColor[0.9904173342488747, \
0.5002822919050889, \
0.0328526741435874]]\)\!\(\*StyleBox[\"k\",FontWeight->\"Bold\",FontColor->\
RGBColor[0.9904173342488747, 0.5002822919050889, \
0.0328526741435874]]\)\!\(\*StyleBox[\" \
