   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The Friedmann continuity and acceleration equations, \
respectively, are the following pair of equations generated by algebraic \
manipulation of \!\(\*SubscriptBox[\(R\), \(00\)]\) and \
\!\(\*SubscriptBox[\(R\), \(11\)]\):\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lhs01", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"lhs", "[", 
          RowBox[{"0", ",", "0"}], "]"}], 
         RowBox[{"n", 
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}]}]]}], "+", 
       FractionBox[
        RowBox[{"lhs", "[", 
         RowBox[{"1", ",", "1"}], "]"}], 
        RowBox[{"n", "-", "1"}]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhs01", "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"rhs", "[", 
         RowBox[{"0", ",", "0"}], "]"}], 
        RowBox[{"n", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}]]}], "+", 
      FractionBox[
       RowBox[{"rhs", "[", 
        RowBox[{"1", ",", "1"}], "]"}], 
       RowBox[{"n", "-", "1"}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
