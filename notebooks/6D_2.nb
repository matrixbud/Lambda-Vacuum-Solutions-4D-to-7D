which includes k>0:\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coefA", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"Numerator", "[", 
        RowBox[{"\[ScriptCapitalA]", "[", "t", "]"}], "]"}], ",", 
       SuperscriptBox[
        RowBox[{
         RowBox[{"a", "'"}], "[", "t", "]"}], "2"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"at0", "[", "t_", "]"}], "=", 
     RowBox[{
      RowBox[{"a", "[", "t", "]"}], "/.", 
      RowBox[{"PowerExpand", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"First", "[", 
          RowBox[{"DSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"0", ",", "0"}], "]"}], "==", 
             SuperscriptBox["c", "2"]}], ",", 
            RowBox[{"a", "[", "t", "]"}], ",", "t"}], "]"}], "]"}], "/.", 
         RowBox[{
          RowBox[{"C", "[", "1", "]"}], "->", "0"}]}], "]"}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at1", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"coefA", " ", 
        RowBox[{
         RowBox[{"Abs", "[", "k", "]"}], "/", "\[CapitalLambda]"}]}], "]"}], 
      RowBox[{"Cosh", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[CapitalLambda]", "/", "coefA"}], "]"}], " ", "c", " ", 
        "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at2", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"coefA", " ", 
        RowBox[{
         RowBox[{"Abs", "[", "k", "]"}], "/", "\[CapitalLambda]"}]}], "]"}], " ", 
      RowBox[{"Sinh", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[CapitalLambda]", "/", "coefA"}], "]"}], " ", "c", " ", 
        "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at3", "=", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Limit", "[", 
         RowBox[{
          RowBox[{"at0", "[", "t", "]"}], ",", 
          RowBox[{"\[CapitalLambda]", "->", "0"}]}], "]"}], ",", 
        RowBox[{"k", "<", "0"}]}], "]"}], "/.", 
      RowBox[{
       SqrtBox[
        RowBox[{"-", "k"}]], "->", 
       SqrtBox[
        RowBox[{"Abs", "[", "k", "]"}]]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at4", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "[", "t", "]"}], "/.", 
       RowBox[{"Last", "[", 
        RowBox[{"DSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"0", ",", "0"}], "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{"k", "->", "0"}], "}"}]}], ")"}], "==", 
           SuperscriptBox["c", "2"]}], ",", 
          RowBox[{"a", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}], "/.", 
      RowBox[{
       RowBox[{"C", "[", "1", "]"}], "->", "\[Alpha]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "msg1", "=", "\"\<if k > 0 & \[CapitalLambda] \[NotEqual] 0               \
            \>\""}], ";"}], "\n", 
   RowBox[{
