    RowBox[{
    "Print", "[", "\"\<  \[Bullet] \[ScriptCapitalA](t) = \
\!\(\*SuperscriptBox[\(c\), \(2\)]\) is the Friedmann Continuity Equation\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<    \[Checkmark] The solution to the equation is the \
a(t) formula from Section b\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] The two constraint rows display \
restrictions on \
\!\(\*StyleBox[\"parameter\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\" \
\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"constants\",FontSlant->\"Italic\"]\
\)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<    \[Checkmark] Due to the field equations\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<    \[Checkmark] Due to KK-bubble smoothness\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] By contrast, \
\!\(\*StyleBox[\"domain\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\" \
\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"restrictions\",FontSlant->\"\
Italic\"]\)\!\(\*StyleBox[\" \
\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"on\",FontSlant->\"Italic\"]\)\!\(\
\*StyleBox[\" \
\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"r\",FontSlant->\"Italic\"]\) \
(RCPC and its analogs) are not\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<    displayed as constraints\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] FG-GRW has the same constraints (both \
rows) as GRW\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The 6D_2 Free-gauge GRW results seen in the table were \
obtained by applying \!\(\*SuperscriptBox[\(r\), \
\(2\)]\)\[Rule]\!\(\*SuperscriptBox[\(r\), \(2\)]\)\[GothicCapitalC], the \
pattern established in 4D, to the GRW parameters generated in Section a. \
Specifically,\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<     \[ScriptCapitalA]: Replace \
\[ScriptCapitalA](t)=\!\(\*SuperscriptBox[\(c\), \(2\)]\) by the \
\[ScriptCapitalA](t) formula\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<     \[CapitalBeta]: Replace \
\!\(\*SuperscriptBox[\(r\), \(2\)]\) \[Rule] \!\(\*SuperscriptBox[\(r\), \
\(2\)]\) \[GothicCapitalC] and multiply result by \
\!\(\*FractionBox[SuperscriptBox[RowBox[{\"(\", RowBox[{RowBox[{\"2\", \"\
\[GothicCapitalC]\"}], \"+\", RowBox[{\"r\", \" \", SuperscriptBox[\"\
\[GothicCapitalC]\", \
FormBox[StyleBox[\"\[Prime]\",FontSize->13,FontWeight->\"Regular\",FontSlant->\
\"Plain\"],TraditionalForm]]}]}], \")\"}], \"2\"], RowBox[{\"4\", \"\
\[GothicCapitalC]\"}]]\)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<     \[GothicCapitalC]: Replace 1 by free parameter \
\[GothicCapitalC]\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<     \!\(\*SubscriptBox[\(\[GothicCapitalD]\), \
\(4\)]\): Replace \!\(\*SuperscriptBox[\(r\), \(2\)]\) by \
\!\(\*SuperscriptBox[\(r\), \(2\)]\)\[GothicCapitalC]\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
