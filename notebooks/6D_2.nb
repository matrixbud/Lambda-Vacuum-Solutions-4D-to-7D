Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Use", " ", "Print", " ", "statements", " ", "and", " ", "then", " ", 
     "view", " ", "results", " ", "in", " ", "the", " ", "output"}], ",", " ", 
    RowBox[{"not", " ", "in", " ", "this", " ", "code"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"lhs", " ", "and", " ", "rhs", " ", 
     RowBox[{"(", "below", ")"}], " ", "set", " ", "field", " ", "equations", 
     " ", "to", " ", "express", " ", "\[IndentingNewLine]", "         ", 
     FractionBox[
      SubscriptBox["R", "\[Mu]\[Nu]"], 
      SubscriptBox["g", "\[Mu]\[Nu]"]]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalLambda]", " ", "if", " ", 
       SubscriptBox["g", "\[Mu]\[Nu]"]}], "\[NotEqual]", 
      RowBox[{"0", " ", "\[IndentingNewLine]", "  ", "and", "   ", 
       SubscriptBox["R", "\[Mu]\[Nu]"]}]}], " ", "=", " ", 
     RowBox[{
     "0", "   ", "otherwise", " ", "\[IndentingNewLine]", "   ", "lhs", " ", 
      "uses", " ", 
      RowBox[{
       RowBox[{"Expand", "[", "Simplify", "]"}], ".", " ", "lhsF"}], " ", 
      "uses", " ", 
      RowBox[{"Expand", "[", "FullSimplify", "]"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lhs", "[", 
      RowBox[{"\[Mu]_", ",", "\[Nu]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "leftside", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "===", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"leftside", " ", "=", 
           RowBox[{"R", "[", 
            RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}], ",", 
          RowBox[{"leftside", "=", 
           RowBox[{"xS", "[", 
            RowBox[{
             RowBox[{"R", "[", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "/", 
             RowBox[{"g", "[", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}], "]"}]}]}], "]"}], ";",
         "leftside"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"lhsF", "[", 
      RowBox[{"\[Mu]_", ",", "\[Nu]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "leftside", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "===", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"leftside", " ", "=", 
           RowBox[{"R", "[", 
            RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}], ",", 
          RowBox[{"leftside", "=", 
           RowBox[{"xF", "[", 
            RowBox[{
             RowBox[{"R", "[", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "/", 
             RowBox[{"g", "[", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}], "]"}]}]}], "]"}], ";",
         "leftside"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rhs", "[", 
      RowBox[{"\[Mu]_", ",", "\[Nu]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "rightside", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "===", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"rightside", " ", "=", 
           RowBox[{"\[CapitalLambda]", " ", 
            RowBox[{"g", "[", 
             RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}]}], ",", 
          RowBox[{"rightside", "=", "\[CapitalLambda]"}]}], "]"}], ";", 
        "rightside"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<6D_2 is the Case where the two curled dimensions form \
a sphere.\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<\!\(\*StyleBox[\"Notation\",FontWeight->\"Bold\",FontColor->RGBColor[0.\
9855344472419318, 0.00946059357595178, \
0.9991760128175784]]\)\!\(\*StyleBox[\" \
\",FontWeight->\"Bold\",FontColor->RGBColor[0.9855344472419318, \
0.00946059357595178, \
0.9991760128175784]]\)\!\(\*StyleBox[\"and\",FontWeight->\"Bold\",FontColor->\
RGBColor[0.9855344472419318, 0.00946059357595178, \
0.9991760128175784]]\)\!\(\*StyleBox[\" \
\",FontWeight->\"Bold\",FontColor->RGBColor[0.9855344472419318, \
0.00946059357595178, \
0.9991760128175784]]\)\!\(\*StyleBox[\"Setup\",FontWeight->\"Bold\",FontColor-\
>RGBColor[0.9855344472419318, 0.00946059357595178, 0.9991760128175784]]\)\!\(\
\*StyleBox[\":\",FontWeight->\"Bold\",FontColor->RGBColor[0.9855344472419318, \
0.00946059357595178, 0.9991760128175784]]\)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{"t_", ",", "r_"}], "]"}], "=", 
     RowBox[{"\[ScriptCapitalA]", "[", "t", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[ScriptCapitalA]", "[", "t_", "]"}], "=", 
     RowBox[{"5", 
      FractionBox[
       SuperscriptBox[
        RowBox[{
         RowBox[{"a", "'"}], "[", "t", "]"}], "2"], 
       RowBox[{
        RowBox[{
         RowBox[{"-", "5"}], "k"}], "+", 
        RowBox[{"\[CapitalLambda]", " ", 
         SuperscriptBox[
          RowBox[{"a", "[", "t", "]"}], "2"]}]}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Asave", "=", 
     RowBox[{"\[ScriptCapitalA]", "[", "t", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalBeta]", "[", "r_", "]"}], "=", 
     RowBox[{"1", "/", 
      RowBox[{
       SubscriptBox["\[GothicCapitalD]", "4"], "[", "r", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[GothicCapitalC]", "[", "r_", "]"}], "=", "1"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"caseMsg", "/.", "rulesDot"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<\!\(\*StyleBox[\"Lambda\",FontWeight->\"Bold\",FontColor->RGBColor[0.6, \
0.4000152590218967, 0.2]]\)\!\(\*StyleBox[\" \
\",FontWeight->\"Bold\",FontColor->RGBColor[0.6, 0.4000152590218967, \
0.2]]\)\!\(\*StyleBox[\"Vacuum\",FontWeight->\"Bold\",FontColor->RGBColor[0.6,\
 0.4000152590218967, 0.2]]\)\!\(\*StyleBox[\" \
\",FontWeight->\"Bold\",FontColor->RGBColor[0.6, 0.4000152590218967, \
0.2]]\)\!\(\*StyleBox[\"Equations\",FontWeight->\"Bold\",FontColor->RGBColor[\
0.6, 0.4000152590218967, \
0.2]]\)\!\(\*StyleBox[\":\",FontWeight->\"Bold\",FontColor->RGBColor[0.6, \
0.4000152590218967, 0.2]]\)\!\(\*StyleBox[\" \
\",FontWeight->\"Bold\",FontColor->RGBColor[0.6, 0.4000152590218967, 0.2]]\) \
The equations are \!\(\*SubscriptBox[\(R\), \(\[Mu]\[Nu]\)]\) = \
\[CapitalLambda] \!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\)]\). They are \
expressed as \!\(\*FractionBox[SubscriptBox[\(R\), \(\[Mu]\[Nu]\)], \
SubscriptBox[\(g\), \(\[Mu]\[Nu]\)]]\) = \[CapitalLambda] when \
\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\)]\) \[NotEqual] 0, and \
\!\(\*SubscriptBox[\(R\), \(\[Mu]\[Nu]\)]\) = 0 when \
\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\)]\) = 0. The \
\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\)]\) matrix used is a diagonal matrix. \
Since off-diagonal \!\(\*SubscriptBox[\(R\), \(\[Mu]\[Nu]\)]\) equations \
rarely appear, almost all the equations are expressed by dividing out \
\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\)]\).\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<\!\(\*StyleBox[\"GRW\",FontWeight->\"Bold\",FontColor->RGBColor[0.6, \
0.4000152590218967, 0.2]]\)\!\(\*StyleBox[\" \
\",FontWeight->\"Bold\",FontColor->RGBColor[0.6, 0.4000152590218967, \
0.2]]\)\!\(\*StyleBox[\"Equations\",FontWeight->\"Bold\",FontColor->RGBColor[\
0.6, 0.4000152590218967, \
0.2]]\)\!\(\*StyleBox[\":\",FontWeight->\"Bold\",FontColor->RGBColor[0.6, \
0.4000152590218967, 0.2]]\) The exact solution to the \[CapitalLambda] vacuum \
field equations that has (1) formulas for \[CapitalBeta], \[GothicCapitalC], \
and \!\(\*SubscriptBox[\(\[GothicCapitalD]\), \(4\)]\), \!\(\*SubscriptBox[\(\
\[GothicCapitalD]\), \(5\)]\), ...., (2) a(t) as a free parameter, and (3) \
parameter \[ScriptCapitalA] such that \[ScriptCapitalA](t) = \
\!\(\*SuperscriptBox[\(c\), \(2\)]\) is the Friedmann Continuity Equation \
(which generates the a(t) formula).\>\"", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<\!\(\*StyleBox[\"a\",FontWeight->\"Bold\",FontColor->RGBColor[1, 0, \
1]]\)\!\(\*StyleBox[\":\",FontWeight->\"Bold\",FontColor->RGBColor[1, 0, \
1]]\)\!\(\*StyleBox[\"  \",FontWeight->\"Bold\",FontColor->RGBColor[1, 0, 1]]\
\)\!\(\*StyleBox[\"GRW\",FontWeight->\"Bold\",FontColor->RGBColor[0.\
9855344472419318, 0.00946059357595178, \
0.9991760128175784]]\)\!\(\*StyleBox[\" \
\",FontWeight->\"Bold\",FontColor->RGBColor[0.9855344472419318, \
0.00946059357595178, \
0.9991760128175784]]\)\!\(\*StyleBox[\"Equations\",FontWeight->\"Bold\",\
FontColor->RGBColor[0.9855344472419318, 0.00946059357595178, \
0.9991760128175784]]\)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<As always, we seek assumptions that can simplify the \
ODEs.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<A pattern has been established in 4D, 5D, and 6D_1 for \
initial assumptions for parameters A and \[GothicCapitalC]:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] A(t,r) = \[ScriptCapitalA](t) = \
\!\(\*FractionBox[\(5\\\ \*SuperscriptBox[\(\(\*OverscriptBox[\(a\), \
\(.\)]\)[t]\), \(2\)]\), \(\(-5\) k + \[CapitalLambda]\\\ \
\*SuperscriptBox[\(a[t]\), \(2\)]\)]\), where curvature k is a free parameter\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] \[GothicCapitalC](r) = 1, which is always \
the case in GRW equations\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<As for the pattern for \[CapitalBeta], the previous \
formulas for \[CapitalBeta] have been:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<    4D:    \[CapitalBeta](r) = \>\"", ",", 
      FractionBox["1", 
       RowBox[{"1", "-", 
        RowBox[{"k", " ", 
         SuperscriptBox["r", "2"]}]}]]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<    5D:    \[CapitalBeta](r) = \>\"", ",", 
      FractionBox["1", 
       RowBox[{"1", "-", 
        RowBox[{"k", " ", 
         SuperscriptBox["r", "2"]}], "+", 
        FractionBox["\[Chi]", "r"]}]], ",", "\"\< = \>\"", ",", 
      FractionBox["1", 
       RowBox[{
        SubscriptBox["\[GothicCapitalD]", "4"], "[", "r", "]"}]]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<    6D_1:  \[CapitalBeta](r) = \!\(\*FractionBox[\(1\), \(1 \
- k\\\ \*SuperscriptBox[\(r\), \(2\)] + \*FractionBox[\(\[Chi]\), \(r\)] + \
\*FractionBox[\(\[CapitalXi]\), SuperscriptBox[\(r\), \(2\)]]\)]\) = \>\"", ",", 
      FractionBox["1", 
       RowBox[{
        SubscriptBox["\[GothicCapitalD]", "5"], "[", "r", "]"}]]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<           (although k and \[CapitalXi] were forced to \
be zero)\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<In 6D_2, there is only one curled object, a 2-sphere (\
\!\(\*SuperscriptBox[\(S\), \(2\)]\)). Consequently, there is only a single \
\!\(\*SubscriptBox[\(\[GothicCapitalD]\), \(\[Mu]\)]\) parameter, namely \!\(\
\*SubscriptBox[\(\[GothicCapitalD]\), \(4\)]\).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<This suggests 3 possibilities for the \
\[CapitalBeta](r) assumption:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  (1) \[CapitalBeta](r) = \>\"", ",", 
      FractionBox["1", 
       RowBox[{
        SubscriptBox["\[GothicCapitalD]", "4"], "[", "r", "]"}]]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  (2) \[CapitalBeta](r) = \>\"", ",", 
      FractionBox["1", 
       SuperscriptBox[
        RowBox[{
         SubscriptBox["\[GothicCapitalD]", "4"], "[", "r", "]"}], "2"]]}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  (3) \[CapitalBeta](r) = \>\"", ",", 
      FractionBox["1", 
       SqrtBox[
        RowBox[{
         SubscriptBox["\[GothicCapitalD]", "4"], "[", "r", "]"}]]]}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Options (2) and (3) arise because the prior patterns \
have been based on circles (\!\(\*SuperscriptBox[\(S\), \(1\)]\)) and now the \
curled object is a sphere. This suggests that either \[CapitalBeta] = \
\!\(\*FractionBox[\(1\), SuperscriptBox[SubscriptBox[\(\[GothicCapitalD]\), \
\(4\)], \(2\)]]\) (option 2) or \!\(\*SubscriptBox[\(\[GothicCapitalD]\), \(4\
\)]\) = \!\(\*FractionBox[\(1\), SuperscriptBox[\(\[CapitalBeta]\), \(2\)]]\) \
(option 3) may be a good choice.\>\"", "]"}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<However, options (2) and (3) can be ruled out: each \
forces k = 0 and its integration constant to zero, giving \[GothicCapitalD]\
\:2084 = \[CapitalBeta] = 1, and then R\:2084\:2084 cannot be satisfied \
because of the curvature of the curled 2-sphere.\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<So, option (1) is the one we pursue.\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<In summary, our assumptions are:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] A(t,r) = \[ScriptCapitalA](t) = \
\!\(\*FractionBox[\(5\\\ \*SuperscriptBox[\(\(\*OverscriptBox[\(a\), \
\(.\)]\)[t]\), \(2\)]\), \(\(-5\) k + \[CapitalLambda]\\\ \
\*SuperscriptBox[\(a[t]\), \(2\)]\)]\), where k is a free parameter\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  \[Bullet] \[CapitalBeta](r) = \>\"", ",", 
      FractionBox["1", 
       RowBox[{
        SubscriptBox["\[GothicCapitalD]", "4"], "[", "r", "]"}]]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] \[GothicCapitalC](r) = 1, \>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[Bullet] \!\(\*SubscriptBox[\(\[GothicCapitalD]\), \
\(4\)]\)(r) is a free parameter so we can solve for its formula.\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The initial Lambda field equations are:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"\[Mu]", "=", "dimL"}], ",", 
      RowBox[{"\[Mu]", "\[LessEqual]", "dimH"}], ",", 
      RowBox[{"\[Mu]", "++"}], ",", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"\[Nu]", "=", "\[Mu]"}], ",", 
        RowBox[{"\[Nu]", "\[LessEqual]", "dimH"}], ",", 
        RowBox[{"\[Nu]", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Mu]", "==", "\[Nu]"}], "||", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Mu]", "\[NotEqual]", "\[Nu]"}], "&&", 
              RowBox[{"!", 
               RowBox[{
                RowBox[{"lhs", "[", 
                 RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "===", "0"}]}]}], 
             ")"}]}], ")"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<R\>\"", ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], "]"}]}], "]"}], 
            ",", "\"\<:  \>\"", ",", 
            RowBox[{
             RowBox[{"lhs", "[", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "/.", "rulesDisp"}], 
            ",", "\"\< = \>\"", ",", 
            RowBox[{"rhs", "[", 
             RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}], "]"}]}], "]"}]}], 
       "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\!\(\*SubscriptBox[\(R\), \(33\)]\) and \
\!\(\*SubscriptBox[\(R\), \(55\)]\) are redundant, the same as \
\!\(\*SubscriptBox[\(R\), \(22\)]\) and \!\(\*SubscriptBox[\(R\), \(44\)]\), \
respectively.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\!\(\*SubscriptBox[\(R\), \(00\)]\) and \
\!\(\*SubscriptBox[\(R\), \(01\)]\) (not listed) are identities due to the \
assumed \[ScriptCapitalA][t] formula.\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[GothicCapitalD]", "4"], "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{"DSolveValue", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"lhs", "[", 
           RowBox[{"2", ",", "2"}], "]"}], "-", "\[CapitalLambda]"}], "==", 
         "0"}], ",", 
        RowBox[{
         SubscriptBox["\[GothicCapitalD]", "4"], "[", "r", "]"}], ",", "r"}], 
       "]"}], "/.", 
      RowBox[{
       RowBox[{"C", "[", "1", "]"}], "->", "\[Chi]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<We can solve \!\(\*SubscriptBox[\(R\), \(22\)]\) for \
\!\(\*SubscriptBox[\(\[GothicCapitalD]\), \(4\)]\):\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<     \!\(\*SubscriptBox[\(\[GothicCapitalD]\), \(4\)]\)(r) = \
\>\"", ",", 
     RowBox[{
      SubscriptBox["\[GothicCapitalD]", "4"], "[", "r", "]"}], 
     ",", "\"\<  where \[Chi] is a constant of integration.\>\""}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<The remaining 2 equations become\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"\[Mu]", "=", "1"}], ",", 
      RowBox[{"\[Mu]", "<=", "4"}], ",", 
      RowBox[{
       RowBox[{"\[Mu]", "++"}], ";", 
       RowBox[{"\[Mu]", "++"}], ";", 
       RowBox[{"\[Mu]", "++"}]}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<R\>\"", ",", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\[Mu]", ",", "\[Mu]"}], "}"}], "]"}]}], "]"}], 
        ",", "\"\<:  \>\"", ",", 
        RowBox[{
         RowBox[{"lhs", "[", 
          RowBox[{"\[Mu]", ",", "\[Mu]"}], "]"}], "/.", " ", "rulesDisp"}], 
        ",", "\"\< = \>\"", ",", 
        RowBox[{"rhs", "[", 
         RowBox[{"\[Mu]", ",", "\[Mu]"}], "]"}]}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\!\(\*SubscriptBox[\(R\), \(11\)]\) \[Implies] \[Chi] \
= 0\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Chi]", "=", "0"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"left", "=", 
     RowBox[{"lhs", "[", 
      RowBox[{"4", ",", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LHS", "[", "1", "]"}], "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"left", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LHS", "[", "2", "]"}], "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"left", "[", 
       RowBox[{"[", 
        RowBox[{"3", ";;", "4"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ls", "[", 
      RowBox[{"4", ",", "4"}], "]"}], "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"LHS", "[", "\[Kappa]", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Kappa]", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< \[Implies]   \!\(\*SubscriptBox[\(R\), \(44\)]\): \>\"", ",", 
      RowBox[{"ls", "[", 
       RowBox[{"4", ",", "4"}], "]"}], ",", "\"\< = \>\"", ",", 
      RowBox[{"rhs", "[", 
       RowBox[{"4", ",", "4"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k0", "=", 
     RowBox[{"k", "/.", 
      RowBox[{"Last", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ls", "[", 
